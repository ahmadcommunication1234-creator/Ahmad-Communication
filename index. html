<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ahmad Communication | iPhone Parts & Online Orders</title>
<style>
:root {
  --site-primary: #142b4a;
  --site-on-primary: #ffffff;
  --site-secondary: #e6a43a;
  --site-on-secondary: #172238;
  --site-background: #f5f7fb;
  --site-on-background: #182338;
  --site-font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --site-font-heading: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --site-heading-scale: 1;
  --site-spacing-scale: 1;
  --site-radius-scale: 1;
  --site-decoration-opacity: 1;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: var(--site-font-body); background: var(--site-background); color: var(--site-on-background); }
.app { min-height: 100vh; background-color: var(--site-background); color: var(--site-on-background); border-radius: 0; }
header { background: var(--site-primary); color: var(--site-on-primary); }
.nav { max-width: 1160px; margin: auto; padding: calc(20px * var(--site-spacing-scale)) 24px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
.logo { display:flex; align-items:center; gap:12px; font-weight:800; letter-spacing:-.03em; font-size:1.1rem; }
.logo-mark { width:38px;height:38px;border-radius:12px;background:var(--site-secondary);color:var(--site-on-secondary);display:grid;place-items:center;font-weight:900; }
nav { display:flex; gap:24px; align-items:center; }
nav a { color:inherit;text-decoration:none;font-size:.92rem;opacity:.9; }
.nav-cta,.btn { border:0;border-radius:999px;padding:12px 18px;background:var(--site-secondary);color:var(--site-on-secondary);font-weight:750;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;cursor:pointer; }
.hero { max-width:1160px;margin:auto;padding:72px 24px 80px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:40px; }
.eyebrow { display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--site-secondary); }
.hero h1 { font-family:var(--site-font-heading);font-size:calc(3.5rem * var(--site-heading-scale));line-height:1.02;letter-spacing:-.06em;margin:18px 0 20px;max-width:640px; }
.hero p { font-size:1.08rem;line-height:1.7;color:light-dark(#d3deeb,#d3deeb);max-width:560px;margin:0 0 28px; }
.hero-actions { display:flex;flex-wrap:wrap;gap:12px; }
.btn-outline { background:transparent;color:white;border:1px solid #52677f; }
.hero-art { min-height:360px;position:relative;display:grid;place-items:center; }
.glow { position:absolute;width:340px;height:340px;border-radius:50%;background:var(--site-secondary);opacity:.14;filter:blur(2px); }
.phone { position:relative;width:190px;height:340px;border:9px solid #111c2b;border-radius:34px;background:linear-gradient(145deg,#f6f8fb,#bcc9d9);box-shadow:0 30px 70px #07172c55;transform:rotate(-8deg); }
.phone:before {content:"";position:absolute;top:8px;left:50%;transform:translateX(-50%);width:72px;height:17px;border-radius:20px;background:#111c2b;}
.phone:after {content:"";position:absolute;inset:28px 9px 10px;border-radius:22px;background:linear-gradient(135deg,#142b4a,#4c7a9f 55%,#e6a43a); }
.parts-card { position:absolute;right:2%;bottom:16%;background:light-dark(#fff,#172338);border:1px solid light-dark(#e1e7ef,#30425b);border-radius:18px;padding:16px 20px;box-shadow:0 16px 40px #07172c20; }
.parts-card strong {display:block;font-size:1.15rem}
.parts-card small {color:light-dark(#617087,#a9b8ca)}
.section {max-width:1160px;margin:auto;padding:68px 24px;}
.section-head {display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px;}
.section h2 {font-size:calc(2.2rem * var(--site-heading-scale));letter-spacing:-.045em;margin:10px 0;}
.section-head p {max-width:470px;line-height:1.6;color:light-dark(#5d6b7e,#a9b8ca);margin:0;}
.products {display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
.product {padding:24px;border-radius:calc(22px * var(--site-radius-scale));background:light-dark(#fff,#172338);border:1px solid light-dark(#e1e7ef,#30425b); }
.product-icon {width:52px;height:52px;border-radius:16px;background:light-dark(#edf3fa,#263b56);display:grid;place-items:center;font-size:1.5rem;margin-bottom:18px;}
.product h3 {margin:0 0 8px;font-size:1.15rem;}
.product p {color:light-dark(#647286,#a9b8ca);line-height:1.55;margin:0 0 18px;font-size:.94rem;}
.tag {font-size:.78rem;font-weight:800;color:var(--site-primary);background:#e9f0f8;border-radius:999px;padding:7px 10px;display:inline-block;}
.info-band {background:var(--site-secondary);color:var(--site-on-secondary);border-radius:calc(28px * var(--site-radius-scale));padding:36px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:24px;}
.info-band h2 {font-size:calc(2rem * var(--site-heading-scale));margin:0 0 10px;}
.info-band p {margin:0;line-height:1.6;max-width:620px;}
.info-band .btn {background:var(--site-primary);color:var(--site-on-primary);white-space:nowrap;}
.contact {display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:start;}
.contact h2 {margin-top:8px;}
.contact p {line-height:1.65;color:light-dark(#5d6b7e,#a9b8ca);}
.contact-box {padding:26px;border-radius:22px;background:light-dark(#fff,#172338);border:1px solid light-dark(#e1e7ef,#30425b);}
.contact-box label {display:block;font-size:.85rem;font-weight:750;margin:12px 0 6px;}
.contact-box input,.contact-box select,.contact-box textarea {width:100%;padding:12px 14px;border-radius:12px;border:1px solid light-dark(#d6deea,#3b4c64);background:var(--site-background);color:var(--site-on-background);font:inherit;}
.contact-box textarea {min-height:90px;resize:vertical;}
.contact-box button {margin-top:16px;width:100%;}
footer {background:var(--site-primary);color:var(--site-on-primary);padding:26px 24px;text-align:center;font-size:.85rem;}
footer span {opacity:.75}
@media(max-width:760px) {
 nav a:not(.nav-cta) {display:none}
 .hero {grid-template-columns:1fr;padding-top:48px;gap:10px}
 .hero h1 {font-size:calc(2.7rem * var(--site-heading-scale))}
 .hero-art {min-height:300px}
 .phone {transform:scale(.85) rotate(-8deg)}
 .products {grid-template-columns:1fr}
 .section-head,.info-band,.contact {grid-template-columns:1fr;display:grid}
 .section-head {align-items:start}
 .info-band .btn {justify-self:start}
}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="nav">
    <div class="logo"><div class="logo-mark">A</div><span>AHMAD<br><small style="font-weight:500;letter-spacing:.08em">COMMUNICATION</small></span></div>
    <nav><a href="#parts">Parts</a><a href="#about">Why us</a><a href="#contact">Contact</a><a class="nav-cta" href="#contact">Get in touch ↗</a></nav>
  </div>
</header>
<main>
<section class="hero">
  <div>
    <span class="eyebrow">● Ahmad Communication · Rawalpindi</span>
    <h1>Your iPhone parts, just a message away.</h1>
    <p>Browse repair parts at Ahmad Communication. Choose the part you need, share your iPhone model and send an order inquiry to confirm price, stock and delivery.</p>
    <div class="hero-actions"><a class="btn" href="#parts">Browse parts →</a><a class="btn btn-outline" href="#contact">Place an inquiry</a></div>
  </div>
  <div class="hero-art" aria-label="Illustration of a smartphone and parts">
    <div class="glow"></div><div class="phone"></div>
    <div class="parts-card"><strong>iPhone parts</strong><small>Repair-ready essentials</small></div>
  </div>
</section>
<section class="section" id="parts">
  <div class="section-head"><div><span class="eyebrow">Ahmad Communication</span><h2>Browse parts and request an order.</h2></div><p>Stock and prices may vary by model and quality grade. Send your requirements to confirm before ordering.</p></div>
  <div class="products">
    <article class="product"><div class="product-icon">▣</div><h3>Displays & screens</h3><p>Display assemblies for common iPhone models. Ask about available quality grades.</p><span class="tag">Model-specific</span></article>
    <article class="product"><div class="product-icon">▰</div><h3>Batteries</h3><p>Replacement batteries to help bring devices back to reliable daily use.</p><span class="tag">Check availability</span></article>
    <article class="product"><div class="product-icon">⌁</div><h3>Charging & flex</h3><p>Charging ports, flex cables and small repair components for technicians.</p><span class="tag">Repair essentials</span></article>
    <article class="product"><div class="product-icon">◉</div><h3>Cameras</h3><p>Camera components and related parts for supported iPhone models.</p><span class="tag">Model-specific</span></article>
    <article class="product"><div class="product-icon">✦</div><h3>Housing & buttons</h3><p>Selected housings, buttons and exterior replacement components.</p><span class="tag">Ask for stock</span></article>
    <article class="product"><div class="product-icon">＋</div><h3>Small components</h3><p>Additional repair parts. Tell us the model and exact component you need.</p><span class="tag">More categories</span></article>
  </div>
  <div class="section-head" style="margin-top:42px"><div><span class="eyebrow">Models covered</span><h2>iPhone 11 to iPhone 18 Pro Max</h2></div><p>Parts categories: displays, batteries, charging flex, cameras, housing, buttons, speakers, microphones, sensors and other small components. Ask us to confirm exact model and stock.</p></div>
  <div class="products">
    <article class="product"><h3>iPhone 11 Series</h3><p>iPhone 11 · 11 Pro · 11 Pro Max</p><span class="tag">All part categories</span></article>
    <article class="product"><h3>iPhone 12 Series</h3><p>iPhone 12 mini · 12 · 12 Pro · 12 Pro Max</p><span class="tag">All part categories</span></article>
    <article class="product"><h3>iPhone 13 Series</h3><p>iPhone 13 mini · 13 · 13 Pro · 13 Pro Max</p><span class="tag">All part categories</span></article>
    <article class="product"><h3>iPhone 14 Series</h3><p>iPhone 14 · 14 Plus · 14 Pro · 14 Pro Max</p><span class="tag">All part categories</span></article>
    <article class="product"><h3>iPhone 15 Series</h3><p>iPhone 15 · 15 Plus · 15 Pro · 15 Pro Max</p><span class="tag">All part categories</span></article>
    <article class="product"><h3>iPhone 16 Series</h3><p>iPhone 16 · 16 Plus · 16 Pro · 16 Pro Max</p><span class="tag">All part categories</span></article>
    <article class="product"><h3>iPhone 17 Series</h3><p>iPhone 17 · 17 Air · 17 Pro · 17 Pro Max</p><span class="tag">Confirm availability</span></article>
    <article class="product"><h3>iPhone 18 Series</h3><p>iPhone 18 · 18 Pro · 18 Pro Max</p><span class="tag">Confirm availability</span></article>
  </div>
</section>
<section class="section" id="about">
  <div class="info-band"><div><h2>Ready to order?</h2><p>Choose a part, tell us your model and quantity, and send an order request. We’ll confirm availability, final price and delivery details.</p></div><a class="btn" href="#contact">Request an order ↗</a></div>
</section>
<section class="section contact" id="contact">
  <div><span class="eyebrow">Ahmad Communication · Orders</span><h2>Send your order request.</h2><p>Tell us the iPhone model, part, quantity and delivery city. We’ll confirm availability, price and delivery options.</p><p><strong>Location:</strong> Rawalpindi, Pakistan<br><strong>Phone / WhatsApp:</strong> 03045806742<br><strong>Email:</strong> ahmadcommunication1234@gmail.com</p></div>
  <form class="contact-box" id="inquiry"><h3>Order inquiry</h3><label for="model">iPhone model</label><input id="model" placeholder="e.g. iPhone 13 Pro" required><label for="part">Part needed</label><select id="part"><option>Display / screen</option><option>Battery</option><option>Charging flex</option><option>Camera</option><option>Housing / buttons</option><option>Other part</option></select><label for="quantity">Quantity</label><input id="quantity" type="number" min="1" value="1" required><label for="city">Delivery city</label><input id="city" placeholder="e.g. Lahore"><label for="message">Details</label><textarea id="message" placeholder="Quality grade, address or any details"></textarea><button class="btn" type="submit">Send order request ↗</button></form>
</section>
</main>
<footer>© <span id="year"></span> Ahmad Communication <span>· Rawalpindi, Pakistan</span></footer>
</div>
<script>
document.getElementById('year').textContent = new Date().getFullYear();
document.getElementById('inquiry').addEventListener('submit', function(e) {
  e.preventDefault();
  const model = document.getElementById('model').value.trim();
  const part = document.getElementById('part').value;
  const quantity = document.getElementById('quantity').value;
  const city = document.getElementById('city').value.trim();
  const details = document.getElementById('message').value.trim();
  const text = `Assalam-o-alaikum Ahmad Communication! I want to order ${quantity} ${part} for ${model}. Delivery city: ${city}. Details: ${details}`;
  // Replace the placeholder below with the shop's WhatsApp number in international format.
  const shopNumber = '923045806742';
  if (!shopNumber) {
    alert('Inquiry prepared:\\n\\n' + text + '\\n\\nAdd the shop WhatsApp number in the website code to enable direct sending.');
    return;
  }
  window.open('https://wa.me/' + shopNumber + '?text=' + encodeURIComponent(text), '_blank');
});
</script>
</body>
</html>
